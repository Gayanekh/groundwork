{
  "$description": "Groundwork design tokens. Single source of truth. Format: W3C Design Tokens Community Group (DTCG) draft. Run `npm run tokens` to regenerate tokens.css and tokens.ts. Never edit generated files by hand.",
  "color": {
    "$type": "color",
    "paper": {
      "base": { "$value": "#F6F4EF", "$description": "App canvas. Warm off-white, reduces glare in long ops sessions." },
      "raised": { "$value": "#FFFFFF", "$description": "Cards, panels, popovers." },
      "sunken": { "$value": "#EFECE5", "$description": "Wells, table headers, inactive tracks." },
      "inverse": { "$value": "#1C1B19", "$description": "Dark surfaces: tooltips, primary buttons, toasts." },
      "inverse-hover": { "$value": "#36332F", "$description": "Hover state of paper.inverse surfaces." }
    },
    "ink": {
      "primary": { "$value": "#1C1B19", "$description": "Body and headings. 15.7:1 on paper.base." },
      "secondary": { "$value": "#57534C", "$description": "Supporting text. 7.0:1 on paper.base." },
      "tertiary": { "$value": "#6B665D", "$description": "Metadata, captions. 5.2:1 on paper.base (AA)." },
      "disabled": { "$value": "#A8A398", "$description": "Disabled text only. Not for information." },
      "inverse": { "$value": "#F6F4EF", "$description": "Text on paper.inverse." },
      "inverse-secondary": { "$value": "#C9C4B9", "$description": "Supporting text on paper.inverse (dark bands)." },
      "inverse-tertiary": { "$value": "#A09B90", "$description": "Metadata on paper.inverse (dark bands)." }
    },
    "line": {
      "subtle": { "$value": "#E7E3DA", "$description": "Dividers inside components." },
      "default": { "$value": "#D9D4C8", "$description": "Component borders." },
      "strong": { "$value": "#8F887A", "$description": "Input borders. 3.5:1 on raised, 3.2:1 on paper.base (WCAG 1.4.11 non-text)." },
      "inverse": { "$value": "#3A3733", "$description": "Hairlines and component borders on paper.inverse (dark bands)." },
      "inverse-strong": { "$value": "#6E695F", "$description": "Stronger borders on paper.inverse. 3.2:1 for non-text boundaries." }
    },
    "mist": {
      "base": { "$value": "#F5F7FA", "$description": "Cool off-white canvas. Remaps paper.base inside [data-surface=mist] (marketing page only)." },
      "sunken": { "$value": "#ECF0F6", "$description": "Remaps paper.sunken inside [data-surface=mist]." },
      "inverse": { "$value": "#14161B", "$description": "Cool near-black band. Remaps paper.inverse inside [data-surface=mist]." },
      "inverse-hover": { "$value": "#2A2D35", "$description": "Remaps paper.inverse-hover inside [data-surface=mist]." },
      "line-subtle": { "$value": "#E2E8F0", "$description": "Remaps line.subtle inside [data-surface=mist]." },
      "line-default": { "$value": "#D3DAE5", "$description": "Remaps line.default inside [data-surface=mist]." },
      "line-strong": { "$value": "#7E8798", "$description": "Remaps line.strong inside [data-surface=mist]. 3.2:1 on mist.base." }
    },
    "core": {
      "canvas": { "$value": "#FFFFFF", "$description": "Remaps paper.base inside [data-surface=core]: pure white page, like the hero." },
      "chip": { "$value": "#F9F9F9", "$description": "Remaps paper.sunken inside [data-surface=core]. Floating chips and quiet panels." },
      "ink": { "$value": "#0E0E0E", "$description": "Remaps paper.inverse and ink.primary inside [data-surface=core]: neutral near-black for the nav bar, text and solid buttons. 18.9:1 on core.canvas." },
      "muted": { "$value": "#696969", "$description": "Remaps ink.tertiary inside [data-surface=core]. 5.5:1 on core.canvas and core.chip." },
      "card": { "$value": "#ECECEC", "$description": "Landing page: feature cards. Not remapped; use as bg-core-card. Text on it uses ink.primary (16.5:1)." },
      "ink-hover": { "$value": "#2B2B2B", "$description": "Remaps paper.inverse-hover inside [data-surface=core]." },
      "ink-secondary": { "$value": "#4D4D4D", "$description": "Remaps ink.secondary inside [data-surface=core]. 8.4:1 on core.canvas." },
      "line-subtle": { "$value": "#EDEDED", "$description": "Remaps line.subtle inside [data-surface=core]. Hairlines between sections." },
      "line-default": { "$value": "#DDDDDD", "$description": "Remaps line.default inside [data-surface=core]." },
      "line-strong": { "$value": "#8A8A8A", "$description": "Remaps line.strong inside [data-surface=core]. 3.4:1 on core.canvas." }
    },
    "wash": {
      "sky": { "$value": "#CFE4F8", "$description": "Atmosphere: upper sky. Decorative only, never behind small text it can't pass AA on." },
      "cloud": { "$value": "#E9F2FB", "$description": "Atmosphere: pale haze between sky and base." },
      "peach": { "$value": "#F7CDB9", "$description": "Atmosphere: soft peach. AA-safe behind ink.secondary text." },
      "coral": { "$value": "#EF8F73", "$description": "Atmosphere: strong coral. Only behind white cards or large decorative areas, never behind text." }
    },
    "ember": {
      "50": { "$value": "#FDF1EA", "$description": "Accent wash: selected rows, active nav." },
      "100": { "$value": "#FADCCB" },
      "400": { "$value": "#E8743B", "$description": "Decorative accent (charts, marks). Text only on paper.inverse (dark bands), never on light surfaces." },
      "600": { "$value": "#B84E1A", "$description": "Accent text, links, focus ring. 5.1:1 on raised, 4.6:1 on paper.base." },
      "700": { "$value": "#933D14", "$description": "Accent hover / pressed." }
    },
    "success": {
      "fg": { "$value": "#23633F" },
      "bg": { "$value": "#E6F2EA" },
      "line": { "$value": "#BFDCC9" }
    },
    "warning": {
      "fg": { "$value": "#865000" },
      "bg": { "$value": "#FBF0D9" },
      "line": { "$value": "#EED29A" }
    },
    "danger": {
      "fg": { "$value": "#A3261B" },
      "bg": { "$value": "#FBE8E5" },
      "line": { "$value": "#F0C1BA" },
      "solid": { "$value": "#B42318", "$description": "Destructive button background." },
      "solid-hover": { "$value": "#8F1C13", "$description": "Destructive button hover." }
    },
    "info": {
      "fg": { "$value": "#2C4F8C" },
      "bg": { "$value": "#E8EEF8" },
      "line": { "$value": "#C3D2EC" }
    },
    "neutral": {
      "fg": { "$value": "#57534C" },
      "bg": { "$value": "#EFECE5" },
      "line": { "$value": "#D9D4C8" }
    }
  },
  "font": {
    "$type": "fontFamily",
    "sans": { "$value": "'Instrument Sans', ui-sans-serif, system-ui, sans-serif", "$description": "All UI text." },
    "serif": { "$value": "'Instrument Serif', ui-serif, Georgia, serif", "$description": "Editorial display only (presentation page, empty-state headlines)." },
    "display": { "$value": "'Cormorant', 'Cormorant Garamond', ui-serif, Georgia, serif", "$description": "Landing hero headline only (large sizes)." },
    "inter": { "$value": "'Inter', ui-sans-serif, system-ui, sans-serif", "$description": "Landing hero text: neutral Inter, regardless of surface." },
    "grotesk": { "$value": "'Inter Tight', 'Inter', ui-sans-serif, system-ui, sans-serif", "$description": "Marketing sans. Replaces font.sans inside [data-surface=mist] (marketing page only)." },
    "mono": { "$value": "'JetBrains Mono', ui-monospace, SFMono-Regular, monospace", "$description": "IDs, numbers in tables, code." }
  },
  "text": {
    "$type": "typography",
    "2xs": { "$value": { "fontSize": "0.6875rem", "lineHeight": "1rem" }, "$description": "11px. Overlines, tiny labels (uppercase + tracking)." },
    "xs": { "$value": { "fontSize": "0.75rem", "lineHeight": "1rem" }, "$description": "12px. Badges, metadata." },
    "sm": { "$value": { "fontSize": "0.8125rem", "lineHeight": "1.25rem" }, "$description": "13px. Dense UI: tables, menus." },
    "base": { "$value": { "fontSize": "0.875rem", "lineHeight": "1.375rem" }, "$description": "14px. Default UI body." },
    "md": { "$value": { "fontSize": "1rem", "lineHeight": "1.5rem" }, "$description": "16px. Inputs on touch, long-form reading." },
    "lg": { "$value": { "fontSize": "1.125rem", "lineHeight": "1.625rem" }, "$description": "18px. Section titles." },
    "xl": { "$value": { "fontSize": "1.375rem", "lineHeight": "1.875rem" }, "$description": "22px. Page titles (mobile)." },
    "2xl": { "$value": { "fontSize": "1.75rem", "lineHeight": "2.25rem" }, "$description": "28px. Page titles." },
    "3xl": { "$value": { "fontSize": "2.5rem", "lineHeight": "2.875rem" }, "$description": "40px. Display." },
    "4xl": { "$value": { "fontSize": "3.5rem", "lineHeight": "3.75rem" }, "$description": "56px. Display." },
    "5xl": { "$value": { "fontSize": "4.75rem", "lineHeight": "4.75rem" }, "$description": "76px. Hero display (presentation only)." },
    "heading": { "$value": { "fontSize": "4rem", "lineHeight": "4rem" }, "$description": "64px. Marketing section heading (medium weight, -0.03em)." },
    "6xl": { "$value": { "fontSize": "6rem", "lineHeight": "5.75rem" }, "$description": "96px. Marketing display (serif only)." },
    "7xl": { "$value": { "fontSize": "7.5rem", "lineHeight": "7rem" }, "$description": "120px. Marketing display (serif only)." },
    "8xl": { "$value": { "fontSize": "10rem", "lineHeight": "9rem" }, "$description": "160px. Marketing masthead, numerals (serif only, large screens)." }
  },
  "spacing": {
    "$type": "dimension",
    "unit": { "$value": "0.25rem", "$description": "4px base unit. Tailwind spacing utilities are multiples of this (p-4 = 16px)." }
  },
  "radius": {
    "$type": "dimension",
    "xs": { "$value": "0.25rem", "$description": "4px. Badges, kbd." },
    "sm": { "$value": "0.375rem", "$description": "6px. Inputs, small buttons." },
    "md": { "$value": "0.5rem", "$description": "8px. Buttons, menus." },
    "lg": { "$value": "0.75rem", "$description": "12px. Cards, dialogs." },
    "xl": { "$value": "1rem", "$description": "16px. Large panels, sheets." },
    "2xl": { "$value": "1.5rem", "$description": "24px. Marketing panels and images." },
    "3xl": { "$value": "2rem", "$description": "32px. Marketing panels." }
  },
  "shadow": {
    "$type": "shadow",
    "xs": { "$value": "0 1px 0 rgb(28 27 25 / 0.04)", "$description": "Resting buttons." },
    "sm": { "$value": "0 1px 2px rgb(28 27 25 / 0.06), 0 1px 1px rgb(28 27 25 / 0.04)", "$description": "Cards." },
    "md": { "$value": "0 4px 12px -2px rgb(28 27 25 / 0.10), 0 2px 4px -2px rgb(28 27 25 / 0.06)", "$description": "Menus, popovers." },
    "lg": { "$value": "0 24px 48px -12px rgb(28 27 25 / 0.22), 0 8px 16px -8px rgb(28 27 25 / 0.10)", "$description": "Dialogs, toasts." },
    "float": { "$value": "0 12px 28px 0 rgb(28 27 25 / 0.12)", "$description": "Marketing: UI cards floating over a gradient, photo or dark panel. Cards that sit on the plain page use a border and no shadow." }
  },
  "duration": {
    "$type": "duration",
    "fast": { "$value": "120ms", "$description": "Hover, press, color changes." },
    "base": { "$value": "180ms", "$description": "Popovers, tabs indicator." },
    "slow": { "$value": "280ms", "$description": "Dialogs, sheets, toasts." }
  },
  "ease": {
    "$type": "cubicBezier",
    "standard": { "$value": [0.2, 0, 0, 1], "$description": "Default for state changes." },
    "out": { "$value": [0.16, 1, 0.3, 1], "$description": "Entrances: elements arriving on screen." },
    "in": { "$value": [0.4, 0, 1, 1], "$description": "Exits." }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": { "$value": "40rem", "$description": "640px. Large phones landscape." },
    "md": { "$value": "48rem", "$description": "768px. Tablet portrait. Table → table (cards below)." },
    "lg": { "$value": "64rem", "$description": "1024px. Sidebar becomes persistent." },
    "xl": { "$value": "80rem", "$description": "1280px. Detail page gets side rail." },
    "2xl": { "$value": "96rem", "$description": "1536px. Content max-width cap." }
  }
}

{
  "$description": "Groundwork design tokens. Single source of truth. Format: W3C Design Tokens Community Group (DTCG) draft. Run `npm run tokens` to regenerate tokens.css and tokens.ts. Never edit generated files by hand.",
  "color": {
    "$type": "color",
    "paper": {
      "base": { "$value": "#F6F4EF", "$description": "App canvas. Warm off-white, reduces glare in long ops sessions." },
      "raised": { "$value": "#FFFFFF", "$description": "Cards, panels, popovers." },
      "sunken": { "$value": "#EFECE5", "$description": "Wells, table headers, inactive tracks." },
      "inverse": { "$value": "#1C1B19", "$description": "Dark surfaces: tooltips, primary buttons, toasts." },
      "inverse-hover": { "$value": "#36332F", "$description": "Hover state of paper.inverse surfaces." }
    },
    "ink": {
      "primary": { "$value": "#1C1B19", "$description": "Body and headings. 15.7:1 on paper.base." },
      "secondary": { "$value": "#57534C", "$description": "Supporting text. 7.0:1 on paper.base." },
      "tertiary": { "$value": "#6B665D", "$description": "Metadata, captions. 5.2:1 on paper.base (AA)." },
      "disabled": { "$value": "#A8A398", "$description": "Disabled text only. Not for information." },
      "inverse": { "$value": "#F6F4EF", "$description": "Text on paper.inverse." }
    },
    "line": {
      "subtle": { "$value": "#E7E3DA", "$description": "Dividers inside components." },
      "default": { "$value": "#D9D4C8", "$description": "Component borders." },
      "strong": { "$value": "#8F887A", "$description": "Input borders. 3.5:1 on raised, 3.2:1 on paper.base (WCAG 1.4.11 non-text)." }
    },
    "ember": {
      "50": { "$value": "#FDF1EA", "$description": "Accent wash: selected rows, active nav." },
      "100": { "$value": "#FADCCB" },
      "400": { "$value": "#E8743B", "$description": "Decorative accent only (charts, marks). Not for text." },
      "600": { "$value": "#B84E1A", "$description": "Accent text, links, focus ring. 5.1:1 on raised, 4.6:1 on paper.base." },
      "700": { "$value": "#933D14", "$description": "Accent hover / pressed." }
    },
    "success": {
      "fg": { "$value": "#23633F" },
      "bg": { "$value": "#E6F2EA" },
      "line": { "$value": "#BFDCC9" }
    },
    "warning": {
      "fg": { "$value": "#865000" },
      "bg": { "$value": "#FBF0D9" },
      "line": { "$value": "#EED29A" }
    },
    "danger": {
      "fg": { "$value": "#A3261B" },
      "bg": { "$value": "#FBE8E5" },
      "line": { "$value": "#F0C1BA" },
      "solid": { "$value": "#B42318", "$description": "Destructive button background." },
      "solid-hover": { "$value": "#8F1C13", "$description": "Destructive button hover." }
    },
    "info": {
      "fg": { "$value": "#2C4F8C" },
      "bg": { "$value": "#E8EEF8" },
      "line": { "$value": "#C3D2EC" }
    },
    "neutral": {
      "fg": { "$value": "#57534C" },
      "bg": { "$value": "#EFECE5" },
      "line": { "$value": "#D9D4C8" }
    }
  },
  "font": {
    "$type": "fontFamily",
    "sans": { "$value": "'Instrument Sans', ui-sans-serif, system-ui, sans-serif", "$description": "All UI text." },
    "serif": { "$value": "'Instrument Serif', ui-serif, Georgia, serif", "$description": "Editorial display only (presentation page, empty-state headlines)." },
    "mono": { "$value": "'JetBrains Mono', ui-monospace, SFMono-Regular, monospace", "$description": "IDs, numbers in tables, code." }
  },
  "text": {
    "$type": "typography",
    "2xs": { "$value": { "fontSize": "0.6875rem", "lineHeight": "1rem" }, "$description": "11px. Overlines, tiny labels (uppercase + tracking)." },
    "xs": { "$value": { "fontSize": "0.75rem", "lineHeight": "1rem" }, "$description": "12px. Badges, metadata." },
    "sm": { "$value": { "fontSize": "0.8125rem", "lineHeight": "1.25rem" }, "$description": "13px. Dense UI: tables, menus." },
    "base": { "$value": { "fontSize": "0.875rem", "lineHeight": "1.375rem" }, "$description": "14px. Default UI body." },
    "md": { "$value": { "fontSize": "1rem", "lineHeight": "1.5rem" }, "$description": "16px. Inputs on touch, long-form reading." },
    "lg": { "$value": { "fontSize": "1.125rem", "lineHeight": "1.625rem" }, "$description": "18px. Section titles." },
    "xl": { "$value": { "fontSize": "1.375rem", "lineHeight": "1.875rem" }, "$description": "22px. Page titles (mobile)." },
    "2xl": { "$value": { "fontSize": "1.75rem", "lineHeight": "2.25rem" }, "$description": "28px. Page titles." },
    "3xl": { "$value": { "fontSize": "2.5rem", "lineHeight": "2.875rem" }, "$description": "40px. Display." },
    "4xl": { "$value": { "fontSize": "3.5rem", "lineHeight": "3.75rem" }, "$description": "56px. Display." },
    "5xl": { "$value": { "fontSize": "4.75rem", "lineHeight": "4.75rem" }, "$description": "76px. Hero display (presentation only)." }
  },
  "spacing": {
    "$type": "dimension",
    "unit": { "$value": "0.25rem", "$description": "4px base unit. Tailwind spacing utilities are multiples of this (p-4 = 16px)." }
  },
  "radius": {
    "$type": "dimension",
    "xs": { "$value": "0.25rem", "$description": "4px. Badges, kbd." },
    "sm": { "$value": "0.375rem", "$description": "6px. Inputs, small buttons." },
    "md": { "$value": "0.5rem", "$description": "8px. Buttons, menus." },
    "lg": { "$value": "0.75rem", "$description": "12px. Cards, dialogs." },
    "xl": { "$value": "1rem", "$description": "16px. Large panels, sheets." }
  },
  "shadow": {
    "$type": "shadow",
    "xs": { "$value": "0 1px 0 rgb(28 27 25 / 0.04)", "$description": "Resting buttons." },
    "sm": { "$value": "0 1px 2px rgb(28 27 25 / 0.06), 0 1px 1px rgb(28 27 25 / 0.04)", "$description": "Cards." },
    "md": { "$value": "0 4px 12px -2px rgb(28 27 25 / 0.10), 0 2px 4px -2px rgb(28 27 25 / 0.06)", "$description": "Menus, popovers." },
    "lg": { "$value": "0 24px 48px -12px rgb(28 27 25 / 0.22), 0 8px 16px -8px rgb(28 27 25 / 0.10)", "$description": "Dialogs, toasts." }
  },
  "duration": {
    "$type": "duration",
    "fast": { "$value": "120ms", "$description": "Hover, press, color changes." },
    "base": { "$value": "180ms", "$description": "Popovers, tabs indicator." },
    "slow": { "$value": "280ms", "$description": "Dialogs, sheets, toasts." }
  },
  "ease": {
    "$type": "cubicBezier",
    "standard": { "$value": [0.2, 0, 0, 1], "$description": "Default for state changes." },
    "out": { "$value": [0.16, 1, 0.3, 1], "$description": "Entrances: elements arriving on screen." },
    "in": { "$value": [0.4, 0, 1, 1], "$description": "Exits." }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": { "$value": "40rem", "$description": "640px. Large phones landscape." },
    "md": { "$value": "48rem", "$description": "768px. Tablet portrait. Table → table (cards below)." },
    "lg": { "$value": "64rem", "$description": "1024px. Sidebar becomes persistent." },
    "xl": { "$value": "80rem", "$description": "1280px. Detail page gets side rail." },
    "2xl": { "$value": "96rem", "$description": "1536px. Content max-width cap." }
  }
}

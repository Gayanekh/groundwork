{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:site",
  "outputDirectory": "dist",
  "redirects": [{ "source": "/storybook", "destination": "/storybook/", "permanent": false }],
  "rewrites": [{ "source": "/((?!assets/|storybook/|favicon.svg).*)", "destination": "/index.html" }]
}
